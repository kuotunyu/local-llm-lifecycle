# 資料（原始 DRCD 與處理後 SFT jsonl 不入 git；SFT dataset 發佈走 HF）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/README.md

# 私人面試筆記與本機開發輔助文檔
PROGRESS.md
interview*.md
INTERVIEW_PREP.md
*.private.md
.agents/
.claude/
CLAUDE.md
PLAN.md
DESIGN.md

# 捨棄的實驗輸出（保留在本機，不入公開版）
*.discarded-*
*.bak-*

# TMMLU+ 全量考卷（20,118 題、約 8.9 MB）：ikala/tmmluplus test split 的逐字副本，
# 由 `51_eval_tmmlu.py --full` 決定性重建，不需要進 git。逐題結果（tmmlu_base.jsonl /
# tmmlu_ft.jsonl）有進 git，那才是這個 repo 產出的東西；qid 是 `<科目>-<test split 列序>`，
# 拿 qid 就能回查原題，稽核性不受影響。
results/eval_raw/tmmlu_sample.json
# 但保留 tmmlu_testset.json（2,000 題平衡子集，約 930 KB）：
# 讓 54_test_option_permutation.py 在乾淨 clone 下也跑得起來，不必先下載資料集或跑 GPU。
!results/eval_raw/tmmlu_testset.json

# 重跑驗證用的暫存結果（不是報告依據）
results/eval_repro_check/

